{
  "name": "pi-aria2-ext",
  "version": "0.1.0",
  "description": "Lightweight, resumable downloads for Pi via a private aria2 daemon",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "aria2",
    "download"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.6.0"
  }
}
